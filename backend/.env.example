# --- Meilisearch ---------------------------------------------------------
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=dev-master-key-change-me
MEILI_INDEX=pages
MEILI_TIMEOUT_S=4

# --- Brave Search fallback ----------------------------------------------
# Create a key at https://api.search.brave.com/app/keys
BRAVE_ENABLED=true
BRAVE_API_KEY=
BRAVE_SAFESEARCH=moderate
# Optional Brave targeting. Leave empty to use Brave defaults (US / en).
BRAVE_COUNTRY=IT
BRAVE_SEARCH_LANG=it
BRAVE_UI_LANG=it-IT
# Ask Brave for up to 5 additional excerpts per result.
BRAVE_EXTRA_SNIPPETS=true

# --- External fallback shield (optional) ---------------------------------
# Order used after Brave when the local page has fewer than MIN_LOCAL_RESULTS.
# Providers with an empty API key are skipped. Remove a name to disable it.
SEARCH_FALLBACK_ORDER=exa,serper,tavily
# fallback = one provider at a time (lowest cost).
# parallel = query providers together and merge their results.
SEARCH_MODE=fallback
# Maximum providers called in parallel mode (1-4).
SEARCH_MAX_PROVIDERS=4
# Reuse a provider response kept in process memory for N seconds (0 = off).
# The cache is bounded, never written to disk and never logged.
PROVIDER_CACHE_TTL_S=180
PROVIDER_CACHE_MAX_ENTRIES=256
# After N consecutive errors a provider is skipped for PROVIDER_COOLDOWN_S
# instead of paying its timeout on every search.
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_S=60

# Exa: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# auto | fast | instant | deep-lite | deep | deep-reasoning | neural
EXA_SEARCH_TYPE=auto
# Enable Exa content moderation.
EXA_MODERATION=true
# Adds an Exa summary per result to the provider insights. Costs extra.
EXA_INCLUDE_SUMMARY=false

# Serper (Google SERP): https://serper.dev
SERPER_API_KEY=
SERPER_GL=it
SERPER_HL=it

# Tavily: https://app.tavily.com
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_LANGUAGE=it
TAVILY_SAFE_SEARCH=true
# Tavily answer/raw content add cost; enable only when needed.
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false

# --- On-demand crawl (Katana) --------------------------------------------
# A search with no local result, or a query that is an http(s) URL, queues a
# Katana crawl in FastAPI BackgroundTasks: the response is never delayed and
# the pages become searchable afterwards.
CRAWL_ENABLED=true
# Binary name resolved with PATH, or an absolute path.
KATANA_BINARY=katana
# Directory for the per-run JSONL files. In Docker it is /data, the writable
# bind mount of ./data; for a backend started outside Docker use a local path
# (e.g. ../data).
CRAWL_OUTPUT_DIR=/data
CRAWL_OUTPUT_PREFIX=dynamic_crawl
# Keep the JSONL files after ingestion (debugging only).
CRAWL_KEEP_OUTPUTS=false
# katana -d: seeds plus N link levels. Keep it low for background crawls.
CRAWL_DEPTH=1
# katana -rl: requests per second towards the crawled site.
CRAWL_RATE_LIMIT=20
# Global token bucket on crawl starts (no client identifier is stored).
# Excess crawls are skipped with reason "rate_limited", never queued.
CRAWL_MAX_STARTS_PER_MINUTE=6
CRAWL_START_BURST=2
# katana -timeout (seconds per request) and hard limit for the process.
CRAWL_REQUEST_TIMEOUT_S=10
CRAWL_TIMEOUT_S=90
# The DNS/public-address check runs in background, before starting Katana.
CRAWL_DNS_TIMEOUT_S=3
# Hard limit for the Meilisearch upload that follows the crawl.
CRAWL_INGEST_TIMEOUT_S=60
# Crawls reserved/running at the same time, process-wide.
CRAWL_MAX_CONCURRENCY=2
# A domain is not crawled again for this long after a successful run,
# and for CRAWL_FAILURE_COOLDOWN_S after a failure.
CRAWL_DOMAIN_COOLDOWN_S=900
CRAWL_FAILURE_COOLDOWN_S=1800
CRAWL_INGEST_BATCH_SIZE=200

# --- Ingestion -----------------------------------------------------------
# Near-duplicate filter (SimHash over the content prefix). A page without
# content is never dropped; the most recently crawled variant wins.
DEDUPE_ENABLED=true
# Similarity in (0, 1]: 1.0 drops only identical text, 0.9 also merges
# lightly edited copies of the same page.
DEDUPE_THRESHOLD=0.9
# Characters of "content" fed to SimHash (200-20000).
DEDUPE_PREFIX_CHARS=2000
# Incremental ingestion has no variable: --skip-unchanged is on by default in
# the CLI and always on in the crawler. --no-skip-unchanged uploads everything.

# --- Tor diagnostics -----------------------------------------------------
# Checked by GET /api/v1/tor-status and by scripts/test_tor.py. Independent
# from the SOCKS5 rotation used for the external providers. This value is for
# a backend started outside Docker; Docker Compose uses the bundled "tor"
# service automatically (socks5://tor:9050).
TOR_ENABLED=true
TOR_PROXY_URL=socks5://127.0.0.1:9050
TOR_STATUS_URL=https://check.torproject.org/api/ip
TOR_TIMEOUT_S=5
# The frontend polls: cache the probe so Tor is not hit on every request.
TOR_CACHE_TTL_S=30

# --- Hybrid behaviour ----------------------------------------------------
# Call the external shield when the local page has fewer than N results.
MIN_LOCAL_RESULTS=3
# Total time budget for the external provider phase, fallback or parallel (seconds).
EXTERNAL_BUDGET_S=8
PAGE_SIZE=10
MAX_PAGE=10

# --- SOCKS5 proxy rotation ------------------------------------------------
# All outbound calls to Brave/Exa/Serper/Tavily can go through rotating
# SOCKS5 proxies. Meilisearch and the preview downloader always stay direct.
PROXY_ENABLED=true
PROXY_LIST_URL=https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks5.txt
# Extra proxies merged with the public list (newline or comma separated):
# host:port, user:pass@host:port or socks5://user:pass@host:port
PROXY_LIST_EXTRA=
# Refresh cadence of the list, and the shorter retry used while the pool is empty.
PROXY_REFRESH_INTERVAL_S=900
PROXY_RETRY_INTERVAL_S=60
PROXY_FETCH_TIMEOUT_S=10
PROXY_STARTUP_TIMEOUT_S=8
# Max candidates kept from the list.
PROXY_POOL_SIZE=50
# Validation: a SOCKS5 handshake by default (no third-party request).
# Set PROXY_VALIDATE_URL to also require a full HTTP GET through the proxy.
PROXY_VALIDATE_ON_LOAD=true
PROXY_VALIDATION_TIMEOUT_S=2.5
PROXY_VALIDATION_CONCURRENCY=20
PROXY_VALIDATE_URL=
# Attempts per provider call, each with a different proxy.
PROXY_MAX_ATTEMPTS=3
PROXY_CONNECT_TIMEOUT_S=2
PROXY_COOLDOWN_S=120
PROXY_MAX_COOLDOWN_S=900
PROXY_MAX_CLIENTS=64
# Last resort: use the server's direct connection when no proxy answers.
# Set false to fail the provider call instead (stricter privacy, less resilient).
PROXY_FALLBACK_DIRECT=true
# Minimum seconds between "using direct connection" warnings.
PROXY_WARNING_INTERVAL_S=60

# --- Request rate limiting -----------------------------------------------
# One in-memory bucket per salted hash of the peer address: the raw address
# is never stored or logged. Behind Next.js the bucket is effectively global.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_CLIENTS=4096

# --- HTTP ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
