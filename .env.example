# Master key shared by Meilisearch and the backend.
# Use at least 16 characters and change it before deploying anywhere.
MEILI_MASTER_KEY=dev-master-key-change-me

# External search providers. Brave has priority; in fallback mode it is tried first.
# Create a Brave key at https://api.search.brave.com/app/keys
BRAVE_API_KEY=

# Optional Brave targeting. Leave empty to use Brave defaults (US / en).
BRAVE_COUNTRY=IT
BRAVE_SEARCH_LANG=it
BRAVE_UI_LANG=it-IT
BRAVE_EXTRA_SNIPPETS=true

# Optional fallback shield, tried in this order after Brave.
# A provider with an empty key is skipped automatically.
SEARCH_FALLBACK_ORDER=exa,serper,tavily
# fallback = one provider at a time (lowest cost).
# parallel = query providers together and merge their results.
SEARCH_MODE=fallback
# Maximum providers called in parallel mode (1-4).
SEARCH_MAX_PROVIDERS=4
# Reuse a provider response kept in process memory for N seconds (0 = off).
PROVIDER_CACHE_TTL_S=180
PROVIDER_CACHE_MAX_ENTRIES=256
# After N consecutive errors a provider is skipped for PROVIDER_COOLDOWN_S.
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_S=60

EXA_API_KEY=
# auto | fast | instant | deep-lite | deep | deep-reasoning | neural
EXA_SEARCH_TYPE=auto
EXA_MODERATION=true
# Adds an Exa summary per result to the provider insights. Costs extra.
EXA_INCLUDE_SUMMARY=false

SERPER_API_KEY=
SERPER_GL=it
SERPER_HL=it

TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_LANGUAGE=it
TAVILY_SAFE_SEARCH=true
# Tavily answer/raw content add cost; enable only when needed.
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false

# SOCKS5 proxy rotation for the external provider calls. The public list is
# refreshed periodically and every candidate is health-checked.
PROXY_ENABLED=true
PROXY_LIST_URL=https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks5.txt
PROXY_LIST_EXTRA=
PROXY_REFRESH_INTERVAL_S=900
PROXY_RETRY_INTERVAL_S=60
PROXY_POOL_SIZE=50
PROXY_VALIDATE_ON_LOAD=true
PROXY_VALIDATION_TIMEOUT_S=2.5
PROXY_MAX_ATTEMPTS=3
PROXY_CONNECT_TIMEOUT_S=2
# Fall back to the server's direct connection when no proxy answers.
PROXY_FALLBACK_DIRECT=true

# On-demand crawl: a search without local results (or an http(s) URL query)
# queues a background Katana crawl and indexes it. The response is immediate.
CRAWL_ENABLED=true
CRAWL_OUTPUT_DIR=/data
CRAWL_DEPTH=1
CRAWL_RATE_LIMIT=20
CRAWL_TIMEOUT_S=90
CRAWL_DNS_TIMEOUT_S=3
CRAWL_MAX_CONCURRENCY=2
CRAWL_DOMAIN_COOLDOWN_S=900
# Global token bucket on crawl starts (no client identifier is stored).
CRAWL_MAX_STARTS_PER_MINUTE=6
CRAWL_START_BURST=2

# Ingestion: near-duplicate filter and incremental refresh.
# --skip-unchanged is on by default in the CLI and always on in the crawler.
DEDUPE_ENABLED=true
DEDUPE_THRESHOLD=0.9
DEDUPE_PREFIX_CHARS=2000

# Tor diagnostics (footer badge and /api/v1/tor-status).
# Docker Compose starts the bundled "tor" service, so Tor does not need to be
# installed on the host. To use another SOCKS5 endpoint from inside the
# backend container, uncomment and change TOR_PROXY_URL_DOCKER (for example
# socks5://host.docker.internal:9050 when Tor runs on the host).
TOR_ENABLED=true
# TOR_PROXY_URL_DOCKER=socks5://tor:9050
TOR_STATUS_URL=https://check.torproject.org/api/ip
TOR_TIMEOUT_S=5
TOR_CACHE_TTL_S=30

# Total time budget for the external provider phase, fallback or parallel (seconds).
EXTERNAL_BUDGET_S=8

# In-memory rate limit on /api/v1/search and /api/v1/suggest, keyed by a
# salted hash of the peer address (never the address itself, never logged).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_CLIENTS=4096

# Allowed browser origins for direct API calls (the Next.js server does not need CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
